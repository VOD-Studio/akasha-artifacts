{
  "name": "akasha-workspace",
  "version": "0.4.1",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "description": "Akasha monorepo — open-source live interactive web artifacts for CLI coding agents.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter '!akasha-workspace' build && node scripts/stage-offline-runtime.mjs",
    "typecheck": "pnpm -r --filter '!akasha-workspace' typecheck",
    "test": "vitest run",
    "lint": "biome check && node scripts/check-deps.mjs",
    "format": "biome check --write",
    "dev": "pnpm -r --parallel dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VOD-Studio/akasha-artifacts.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
