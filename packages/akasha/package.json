{
  "name": "akasha-artifacts",
  "version": "0.6.0",
  "description": "Open-source live web artifacts for CLI coding agents (Claude Code, Codex CLI, Antigravity) — local & cloud self-hosted.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "akasha": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "@akasha/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "node ../../scripts/dev-daemon.mjs",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VOD-Studio/akasha-artifacts.git"
  },
  "keywords": [
    "akasha",
    "artifacts",
    "claude-code",
    "claude-artifacts",
    "codex",
    "antigravity",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "live-preview"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@akasha/protocol": "workspace:*",
    "@akasha/server": "workspace:*",
    "@akasha/mcp": "workspace:*",
    "@akasha/hooks": "workspace:*",
    "@akasha/skills": "workspace:*"
  }
}
