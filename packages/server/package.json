{
  "name": "@akasha/server",
  "version": "0.1.0",
  "description": "Akasha Local Daemon and Cloud Hub server",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@akasha/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
