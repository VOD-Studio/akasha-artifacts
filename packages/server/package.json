  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@akasha/jsx-source": "workspace:*",
    "@akasha/protocol": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@hono/node-ws": "^1.3.0",
    "hono": "^4.13.0",
    "ws": "^8.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0"
  }
}
