{
  "name": "@akasha/jsx-source",
  "version": "0.1.0",
  "description": "JSX/HTML source location injection and AST edit rewriting",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@akasha/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@akasha/protocol": "workspace:*",
    "@babel/parser": "^8.1.3",
    "parse5": "^8.1.1"
  }
}
